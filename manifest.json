{
  "schemaVersion": 1,
  "id": "io.github.sshbrian.comfyui-status",
  "name": "ComfyUI",
  "version": "2.0.0",
  "author": "sshbrian",
  "license": "MIT",
  "description": "ComfyUI generation status: idle, sampler progress, it/s, and a click-to-open dashboard.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "ComfyUI",
    "description": "Idle, sampler progress, it/s, and a click-to-open generation dashboard.",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "host": "127.0.0.1",
      "port": 8188
    },
    "schema": [
      {
        "key": "host",
        "type": "string",
        "label": "Host",
        "defaultValue": "127.0.0.1"
      },
      {
        "key": "port",
        "type": "integer",
        "label": "Port",
        "min": 1,
        "max": 65535,
        "step": 1,
        "defaultValue": 8188
      }
    ]
  }
}
